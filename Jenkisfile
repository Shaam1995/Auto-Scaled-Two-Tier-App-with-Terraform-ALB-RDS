pipeline {
    agent any
    
    environment {
        // ID of the private key credential stored in Jenkins
        EC2_CREDENTIALS_ID = 'your-ec2-ssh-key-credential-id'
        
        // Destination EC2 details
        EC2_2_USER = 'ubuntu' // e.g., ubuntu, ec2-user
        EC2_2_IP = '172.31.11.132' // Public or Private IP of EC2-2
        DEST_PATH = '/var/www/html' // Target directory on EC2-2
        
        // Source file path (if running on EC2-1 workspace)
        SOURCE_FILE = 'index.html'
    }
    
    stages {
        stage('Copy Index File to EC2-2') {
            steps {
                sshagent(credentials: ["${env.EC2_CREDENTIALS_ID}"]) {
                    sh """
                        # Disable strict host key checking to prevent prompt block
                        scp -o StrictHostKeyChecking=no ${SOURCE_FILE} ${env.EC2_2_USER}@${env.EC2_2_IP}:${env.DEST_PATH}
                    """
                }
            }
        }
    }
}

